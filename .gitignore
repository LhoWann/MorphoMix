# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Tool caches
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Data: raw downloads and everything `main.py prepare` builds (ALL-IDB2 is not redistributable).
# Only the split and group CSVs are tracked, for a leakage-free, reproducible bootstrap.
data/raw/
data/processed/*
!data/processed/splits/

# The final results behind the paper (checkpoints, per-image predictions, tables, figures, logs; results/proxy holds the
# reduced-data tuning runs) and the superseded runs in archive/
results/
archive/

# Archives (Colab code / data archives from colab/pack.py, Overleaf exports)
*.zip
*.tar
*.tar.gz
*.7z

# Model weights anywhere
*.pt
*.pth
*.onnx
*.ckpt

# Private or local-only material
#   writing/publish/     journal paper: manuscript, Overleaf zip, references, notes, supervision, journal guide, release
#   writing/tata_tulis/  Tata Tulis course: proposal, seminar slides and script, response to the lecturer, matrix
#   docs/                private decision log
#   agent_space/         agent scratch space
writing/
docs/
agent_space/
.claude/
.agents/
CLAUDE.md

